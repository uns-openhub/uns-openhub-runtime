[Unit]
Description=UNS OpenHub verified local recovery retention
After=network-online.target
Wants=network-online.target
ConditionPathExists=@BACKUP_ROOT@/recovery-policy.json

[Service]
Type=oneshot
User=root
ExecStart=@RUNTIME_DIR@/bin/uns environment backup retention-run --mounted-policy --mode @MODE@ --root @BACKUP_ROOT@ --dsmc @DSMC@
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=6h
