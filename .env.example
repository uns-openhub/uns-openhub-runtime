# Registry image coordinates (required)
UNS_REGISTRY=fra.ocir.io
UNS_REPO_PREFIX=fricdwfcid28
UNS_TAG=latest

# Controller config to load from configs/uns-datahub-controller
CONFIG_FILE=config-example.json
# Controller container user (defaults to root)
CONTROLLER_USER=root

# Local infra defaults used by docker-compose.infra.yml and docker-compose.yml
POSTGRES_USER=uns
POSTGRES_PASSWORD=change-me
POSTGRES_DB=uns

# Optional local controller integrations. Leave blank if unused.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SCOPE=
AZURE_TENANT_ID=
OPENAI_KEY=

# Docker Desktop/Linux Docker: leave empty.
# Podman/SELinux: set to ",z" or ",Z" to relabel bind mounts so containers can read mounted files.
BIND_MOUNT_LABEL=
