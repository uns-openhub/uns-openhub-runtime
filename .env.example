# Registry image coordinates (required)
UNS_REGISTRY=docker.io
UNS_REPO_PREFIX=unsopenhub
UNS_CONTROLLER_REPOSITORY=uns-openhub-controller
UNS_POSTGRES_REPOSITORY=uns-postgres
UNS_TAG=2.1.92
UNS_BACKUP_DIR=./backups

# Controller config to load from configs/uns-openhub-controller
CONFIG_FILE=config-example.json
# Controller container user (defaults to root)
CONTROLLER_USER=root

# Local infra defaults used by docker-compose.infra.yml and docker-compose.yml
POSTGRES_USER=uns
POSTGRES_PASSWORD=change-me
POSTGRES_DB=uns

# Docker Desktop/Linux Docker: leave empty.
# Podman/SELinux: set to ",z" or ",Z" to relabel bind mounts so containers can read mounted files.
BIND_MOUNT_LABEL=
