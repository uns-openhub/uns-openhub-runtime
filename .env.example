# Registry image coordinates (required)
UNS_REGISTRY=docker.io
UNS_REPO_PREFIX=unsopenhub
UNS_CONTROLLER_REPOSITORY=uns-openhub-controller
UNS_POSTGRES_REPOSITORY=uns-postgres
UNS_TAG=2.2.54
UNS_BACKUP_DIR=./backups
# Existing published recovery bundles may be registered below this separate,
# read-only mount. It remains outside the replaceable Runtime directory.
UNS_EXTERNAL_RECOVERY_DIR=./external-recovery

# Deployment topology managed by the uns init command.
UNS_TOPOLOGY=single
UNS_CONTROLLER_COUNT=1

# Controller config to load from configs/uns-openhub-controller
CONFIG_FILE=config-example.json
# Controller container user (defaults to root)
CONTROLLER_USER=root

# Local infra defaults used by docker-compose.infra.yml and docker-compose.yml
POSTGRES_USER=uns
POSTGRES_PASSWORD=change-me
POSTGRES_DB=uns

# Docker Desktop/Linux Docker: leave empty.
# Podman/SELinux: set to ",z" or ",Z" to relabel bind mounts so containers can read mounted files.
BIND_MOUNT_LABEL=
# Optional owner-managed roots: explicitly empty disables recursive engine relabel.
# Install/review persistent SELinux labels first; unset inherits BIND_MOUNT_LABEL.
# UNS_BACKUP_BIND_LABEL=
# UNS_RECOVERY_BIND_LABEL=
