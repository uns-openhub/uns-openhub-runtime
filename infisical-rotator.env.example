# Infisical rotator configuration
# Copy to /etc/uns/infisical-rotator.env and set real values, then chown root:root and chmod 600.

INFISICAL_CLIENT_ID=your-client-id
INFISICAL_CLIENT_SECRET=your-client-secret
INFISICAL_PROJECT_ID=your-project-id
INFISICAL_SITE_URL=https://vault.example.com
# Optional:
# INFISICAL_AUTH_PATH=/api/v1/auth/universal-auth/login  # use this for older Infisical builds; default is /api/v2/...
# SECRETS_DIR=/var/lib/uns/secrets
# TOKEN_FILE=infisical_token
# PROJECT_ID_FILE=infisical_project_id
# SITE_URL_FILE=infisical_site_url
# TOKEN_MARGIN_SECONDS=90
# SECRETS_USER=uns   # ignored on Windows
# SECRETS_GROUP=uns  # ignored on Windows
# POST_ROTATE_COMMAND=systemctl --user restart uns-controller.service
