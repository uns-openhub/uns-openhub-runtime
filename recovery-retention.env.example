# Absolute installed Runtime and recovery storage paths.
UNS_RUNTIME_DIR=/home/uns/uns-openhub-runtime
UNS_BACKUP_ROOT=/home/uns/uns-openhub-runtime-data/backups

# Start in plan mode. Change to apply only after reviewing and manually applying
# the first eligible 30-day retention plan.
UNS_RETENTION_MODE=plan
UNS_RETENTION_MINIMUM_AGE_DAYS=30
UNS_RETENTION_KEEP_LATEST=3

# IBM Storage Protect client and freshness guard.
UNS_TSM_DSMC=/opt/tivoli/tsm/client/ba/bin/dsmc
UNS_TSM_MAX_FILESPACE_AGE_HOURS=36
