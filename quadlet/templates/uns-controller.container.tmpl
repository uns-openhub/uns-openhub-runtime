[Unit]
Description=UNS DataHub Controller
After=uns-postgres.service uns-mosquitto.service

[Container]
ContainerName=uns-datahub-controller
Image={{.ControllerImage}}
Pull=missing
Network=uns-datahub.network
NetworkAlias=uns-datahub-controller
EnvironmentFile={{.EnvFile}}
Environment=CONFIG_OVERRIDES_DIR=/usr/src/app/config-overrides
Environment=CRYPTO_DIR=/usr/src/app/crypto
Environment=NODE_ENV=production
User={{.ControllerUser}}
PublishPort=3200:3200
Volume={{.ControllerConfigMount}}
Volume={{.SecretsMount}}
Volume=uns-crypto.volume:/usr/src/app/crypto
Volume=uns-controller-code.volume:/usr/src/app/controller-override
Volume=uns-rtt-nodes.volume:/usr/src/app/rtt-nodes
HealthCmd=sh -c "wget -qO- http://127.0.0.1:3200/api/healthcheck >/dev/null 2>&1 || exit 1"
HealthInterval=30s
HealthTimeout=5s
HealthRetries=5
HealthStartPeriod=15s
Notify=healthy

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy={{.InstallTarget}}
