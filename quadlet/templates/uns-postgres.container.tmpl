[Unit]
Description=UNS DataHub PostgreSQL

[Container]
ContainerName=uns-postgres
Image={{.PostgresImage}}
Pull=missing
Network=uns-datahub.network
NetworkAlias=postgres
EnvironmentFile={{.EnvFile}}
PublishPort=5432:5432
Volume=uns-pgdata.volume:/var/lib/postgresql
Volume={{.PostgresConfigMount}}
HealthCmd=CMD-SHELL PGPASSWORD=$$POSTGRES_PASSWORD pg_isready -h 127.0.0.1 -U $$POSTGRES_USER
HealthInterval=10s
HealthTimeout=5s
HealthRetries=5
Notify=healthy

[Service]
Restart=always
TimeoutStartSec=90

[Install]
WantedBy={{.InstallTarget}}
